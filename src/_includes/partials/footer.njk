<footer class="site-footer">
  <div class="wrap">
    <div class="site-info">
      <p>© Curtain's Up Drama School {{ site.year }}</p>
      <p>{{ site.footerLocation | safe }}</p>

      <div class="row">
        <div><img src="{{ '/assets/images/icons/phone.png' | url }}" width="30" height="30" alt="Phone Us!"> <a href="tel:{{ site.phone }}">{{ site.phone }}</a></div>
        <div><a href="mailto:{{ site.email }}"><img src="{{ '/assets/images/icons/email.png' | url }}" width="30" height="30" alt="Email Us!"> {{ site.email }}</a></div>
      </div>
      <div class="row">
        <div><a href="{{ site.whatsapp }}"><img src="{{ '/assets/images/icons/whatsapp.png' | url }}" width="30" height="30" alt="Chat on WhatsApp!"> {{ site.phone }}</a></div>
        <div><a href="{{ site.facebook.url }}"><img src="{{ '/assets/images/icons/facebook.png' | url }}" width="30" height="30" alt="Follow Us on Facebook!"> {{ site.facebook.label }}</a></div>
        <div><a href="{{ site.instagram.url }}"><img src="{{ '/assets/images/icons/instagram.png' | url }}" width="30" height="30" alt="Follow Us on Instagram!"> {{ site.instagram.label }}</a></div>
      </div>

      <div class="row keywords">
        {% for column in site.footerKeywords %}
        <div>{% for line in column %}{{ line }}<br>{% endfor %}</div>
        {% endfor %}
      </div>
    </div>
  </div>
</footer>
