---
layout: layouts/page.njk
---
{{ content | safe }}
<ul class="gallery">
  {% for image in galleries[gallery] %}
  <li>
    <a href="/assets/images/{{ gallery }}/{{ image.file }}">
      <img src="/assets/images/{{ gallery }}/{{ image.file }}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ image.alt }}" loading="lazy">
    </a>
  </li>
  {% endfor %}
</ul>
